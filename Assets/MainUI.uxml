<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Main.uss?fileID=7433441132597879392&amp;guid=06c9a3a0d46f58c4ca5081dfdf307fd4&amp;type=3#Main" />
    <ui:VisualElement name="Main" style="flex-grow: 1; align-items: flex-start; align-content: stretch; flex-direction: row; justify-content: space-around; align-self: flex-start; width: 100%; height: 100%;">
        <ui:VisualElement name="UpperMenu" style="height: 20%; align-items: flex-start; width: 74%; flex-direction: column; justify-content: flex-start; align-self: stretch;">
            <ui:VisualElement name="MenuPanel" class="UIBlock" style="flex-grow: 1; height: 55%; width: auto; align-content: flex-start; align-self: stretch; align-items: flex-start; justify-content: flex-start; padding-bottom: 0; margin-bottom: 6px;">
                <ui:Button text="Modes" name="Button" class="UpButton" />
                <ui:Button text="Kek" name="Button" class="UpButton" />
            </ui:VisualElement>
            <ui:VisualElement name="Tools" style="flex-grow: 1; width: auto; align-self: stretch;">
                <ui:Button text="Create" name="ToolButtons" style="width: 55px; height: 55px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="LeftMenu" class="UIBlock" style="height: 100%; width: 0; align-self: flex-start; align-items: flex-start; align-content: flex-start; justify-content: flex-start;">
            <ui:Button text="Modes" name="Button" class="LeftMenuButton" style="justify-content: center;" />
            <ui:Button text="Kek" name="Button" class="LeftMenuButton" />
