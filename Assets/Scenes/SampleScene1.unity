  m_Name: 
  m_EditorClassIdentifier: 
  textTMP: {fileID: 0}
  text: {fileID: 0}
  RuText: "\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C \"\u0416\u0430\u0434\u043D\u044B\u0439
    \u043F\u043E\u0438\u0441\u043A\" - \u044D\u0442\u043E \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F, \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0448\u0430\u0433\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
    \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
    \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0432 \u043D\u0430\u0434\u0435\u0436\u0434\u0435
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u043E
    \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435."
  EngText: The "Greedy search" algorithm is an algorithmic strategy in which a locally
    optimal solution is made at each step in the hope of obtaining a globally optimal
    solution.
  _language: 0
