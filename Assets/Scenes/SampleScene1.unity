    - target: {fileID: 4793675948689906721, guid: 2b33d8a738da94f49a288d23ecff9da9, type: 3}
      propertyPath: m_text
      value: "\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C \u0414\u0435\u043A\u0441\u0442\u0440\u044B
        - \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
        \u043F\u043E\u0448\u0430\u0433\u043E\u0432\u043E: \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C
        \u0448\u0430\u0433\u0435 \u043E\u043D \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442
        \u043D\u0430\u0438\u043C\u0435\u043D\u0435\u0435 \u043E\u0442\u0434\u0430\u043B\u0451\u043D\u043D\u0443\u044E
        \u0432\u0435\u0440\u0448\u0438\u043D\u0443 \u0438 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
        \u043A \u043D\u0435\u0439, \u0437\u0430\u0442\u0435\u043C \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
        \u2014 \u0438 \u0442\u0430\u043A, \u043F\u043E\u043A\u0430 \u043D\u0435 \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F
        \u0434\u043E \u0446\u0435\u043B\u0438."
      objectReference: {fileID: 0}
