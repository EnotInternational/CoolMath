--- !u!114 &1120151333
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1120151329}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e6bb080dda09d44a95d4c41bc0c79b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textTMP: {fileID: 0}
  text: {fileID: 0}
  RuText: "\u041A\u043D\u043E\u043F\u043A\u0430 \"\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
    \u0448\u0430\u0433\" - \u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442
    \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0448\u0430\u0433 \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C\u0430"
  EngText: The "Next step" button reproduces the next step of the algorithm.
  _language: 0
--- !u!1 &1132165332 stripped
GameObject:
  m_CorrespondingSourceObject: {fileID: 7105105079191130120, guid: 2b33d8a738da94f49a288d23ecff9da9, type: 3}
  m_PrefabInstance: {fileID: 311542192}
  m_PrefabAsset: {fileID: 0}
--- !u!114 &1132165336
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1132165332}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e6bb080dda09d44a95d4c41bc0c79b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textTMP: {fileID: 0}
  text: {fileID: 0}
  RuText: "\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C \u043F\u043E\u0438\u0441\u043A\u0430
    \u0432 \u0448\u0438\u0440\u0438\u043D\u0443 - \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435
    \u043E\u0431\u0445\u043E\u0434\u0430 \u043E\u043D \u0438\u0434\u0451\u0442 \u0432\u0448\u0438\u0440\u044C:
    \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C \u043A\u0430\u043A \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u044C
    \u043A \u043F\u043E\u0438\u0441\u043A\u0443 \u0432\u0435\u0440\u0448\u0438\u043D
    \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 k+1,
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442\u0441\u044F \u043E\u0431\u0445\u043E\u0434
    \u0432\u0435\u0440\u0448\u0438\u043D \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438
    k."
  EngText: 'The breadth-first search algorithm is a breadth-first search: before
    starting to search for vertices at a distance of k+1, the vertices at a distance
    of k are traversed.'
  _language: 0
