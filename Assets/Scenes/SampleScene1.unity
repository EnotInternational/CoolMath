      value: "\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C \u043F\u043E\u0438\u0441\u043A\u0430
        \u0432 \u0448\u0438\u0440\u0438\u043D\u0443-\u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435
