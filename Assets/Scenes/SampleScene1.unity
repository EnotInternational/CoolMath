--- !u!114 &381635531
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 381635527}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e6bb080dda09d44a95d4c41bc0c79b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textTMP: {fileID: 0}
  text: {fileID: 0}
  RuText: "\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C \u0410* - \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C
    \u043F\u043E\u0438\u0441\u043A\u0430 \u043F\u043E \u043F\u0435\u0440\u0432\u043E\u043C\u0443
    \u043D\u0430\u0438\u043B\u0443\u0447\u0448\u0435\u043C\u0443 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u044E
    \u043D\u0430 \u0433\u0440\u0430\u0444\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
    \u0441 \u043D\u0430\u0438\u043C\u0435\u043D\u044C\u0448\u0435\u0439 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E"
  EngText: Algorithm A* is an algorithm for searching for the first best match on
    a graph that finds the route with the lowest cost.
  _language: 0
